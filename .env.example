# Leave empty locally so the browser uses same-origin /api (Vite proxy).
# vite.config.js: POST /api/v1/enquiries → http://127.0.0.1:8000
# Other /api → https://api.mkconstruction.site
# Production builds still use https://api.mkconstruction.site when this is empty.
VITE_API_URL=
VITE_MEDIA_URL=https://api.mkconstruction.site
